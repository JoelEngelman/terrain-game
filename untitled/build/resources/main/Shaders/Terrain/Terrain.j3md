MaterialDef Terrain {

    MaterialParameters {
        Color BaseColor
    }

    Technique {
        VertexShader GLSL100: Shaders/Terrain/Terrain.vert
        FragmentShader GLSL100: Shaders/Terrain/Terrain.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            NormalMatrix
            CameraPosition
        }

        Defines {
        }
    }
}